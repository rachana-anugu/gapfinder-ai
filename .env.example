# ========================================================
# GapFinder AI Environment Variables
# ========================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Provider Configuration ('gemini' or 'openai')
LLM_PROVIDER=gemini

# Gemini API Key (default)
# Used for generation and text-embedding-004 (768 dimensions)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# OpenAI API Key (optional alternative)
# Used if LLM_PROVIDER=openai (supports gpt-4o-mini & text-embedding-3-small at 768 dimensions)
OPENAI_API_KEY=your-openai-api-key

# Embedding Dimension (Strictly 768)
EMBEDDING_DIMENSION=768

# Retrieval Confidence Threshold (Refusal below this score)
RETRIEVAL_THRESHOLD=0.45
